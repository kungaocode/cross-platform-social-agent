    "allow_weather_tool": false,
    "allow_research_tool": false,
    "multimodal_mode": "mention",
    "allow_ocr_tool": false,
    "allow_speech_tool": false,
    "weather_ip_location": true,
    "allow_moments_publish": false,
    "allow_moments_comment": false,
    "allow_media_tool": false,
    "allow_group_tools": false,
    "allow_vision_tool": false,
    "allow_poke_tool": false,
    "allow_document_tool": false,
    "allow_link_tool": false,
    "allow_audio_tool": false,
    "emoji_enabled": true,
    "emoji_max_count": 2,
    "emoji_stickers_enabled": true,
    "weather_timeout_seconds": 15,
    "weather_provider": "amap",
    "allow_time_tool": false,
    "allow_video_tool": false,
    "cache_directory": "data/cache",
    "research_backends": [
      "ddgs_duckduckgo",
      "baidu_api",
      "bocha_api"
