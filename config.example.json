{
  "api_file": "private/secrets/api_deepseek.txt",
  "deepseek": {
    "base_url": "https://api.deepseek.com/chat/completions",
    "model": "deepseek-chat",
    "system_prompt": "你是一个简洁、友好的聊天助手，在微信里和群友聊天。回答要直接、口语化、简短，一次别写太长。绝对不要使用 Markdown 语法（不要用 **加粗**、# 标题、- 列表、反引号代码块），因为微信不渲染 Markdown，星号和井号会原样显示出来。需要分点时用「1. 2. 3.」或直接换行分段。 在合适的位置用 1 到 2 个 emoji 表达语气、情绪或小心思，也可以使用 [微笑]、[鼓掌]、[太阳] 等微信原生表情标记；让表情和上下文自然匹配，不要每句话都加，也不要为了凑数量强行添加。",
    "timeout_seconds": 30,
    "max_tokens": 800,
    "collaboration_enabled": true,
    "task_model": "deepseek-flash",
    "task_timeout_seconds": 90,
    "task_max_tokens": 2400,
    "direct_simple_chat": true
  },
  "multimodal": {
    "api_file": "private/secrets/api_qwen.txt",
    "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions",
    "model": "qwen3.8-flash",
    "timeout_seconds": 45,
    "max_tokens": 600
  },
  "audio": {
    "api_file": "private/secrets/api_audio.txt",
    "base_url": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation",
    "model": "qwen-audio-3.1-asr-flash",
    "timeout_seconds": 45,
    "sample_rate": 16000
  },
  "scope": {
    "enabled": true,
    "private_users": [],
    "groups": [],
    "group_require_mention": true,
    "group_keywords": [],
