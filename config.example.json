    "group_activation_enabled": true,
    "group_activate_keyword": "转人机",
    "group_activate_reply": "大肥鱼收到",
    "group_deactivate_keyword": "转人工",
    "group_deactivate_reply": "已转人工，机器人已停止回复。"
  },
  "runtime": {
    "database_path": "data/memory/current/wechat-default.sqlite3",
    "wechat_group_memory_enabled": false,
    "max_context_messages": 12,
    "cooldown_seconds": 8,
