    "research_bocha_key_env": "BOCHA_API_KEY",
    "research_baidu_key_env": "BAIDU_SEARCH_API_KEY",
    "research_credentials_file": "private/secrets/search_credentials.json",
    "research_domestic_direct": true,
    "research_duckduckgo_mode": "browser",
    "research_duckduckgo_timeout_seconds": 15,
    "research_duckduckgo_browser_channel": "msedge",
    "research_duckduckgo_profile": "data/memory/current/duckduckgo-browser-profile",
    "agent_memory_enabled": true,
    "agent_memory_path": "data/memory/current/agent-memory.sqlite3",
    "agent_memory_retry_seconds": 30,
    "memory_account_id": "default"
  },
  "moments": {
    "enabled": false,
    "wait_for_comments": true,
    "duration_minutes": 120,
    "template_file": "",
    "template": "开头是‘早上好，这里是大肥鱼’；轻松和大家打招呼，提到第一次见面、请多关照；播报今日天气（城市、天气、温度、穿衣/带伞提醒）；加一句‘如果大家想要和我互动，可以在评论区和我交流哦’；最后送上关爱祝福。全文100字以内，亲切自然，用1-2个emoji表达情绪或小心思，不要为了凑数量添加。\n参考成品：早上好，这里是大肥鱼🐟\n第一次见面，请多关照～\n今日【城市】【天气】，【温度】，出门记得【带伞/添衣】。\n如果大家想要和我互动，可以在评论区和我交流哦～\n愿大家平安顺遂，吃好睡好，天天好心情☀️",
    "closing_text": "肥鱼累了不回消息了，睡觉去咯",
    "media_files": [],
    "privacy_config": {},
    "poll_interval_seconds": 30,
    "weather_enabled": true,
    "weather_location": "",
    "comment_reply_mode": "comment",
    "comment_via": "api",
    "opening_comment_text": "",
    "opening_comment_template": "",
    "max_content_chars": 100,
    "emoji_enabled": true,
    "emoji_max_count": 2,
    "emoji_stickers_enabled": true,
    "comment_reply_template": "你在自己刚发布的朋友圈下收到了一条评论：\n{comment}\n请生成一句自然、简短、友好的回复，只返回回复正文，不要解释，不要使用 Markdown；可用少量 emoji 表达情绪或小心思。"
  },
  "wechat": {
    "enabled": false,
    "targets": [],
    "bot_name": "",
    "reply_mode": "text"
  },
